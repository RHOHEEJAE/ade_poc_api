# 로컬 실행용. 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# Vercel 에서는 같은 이름으로 Project Settings → Environment Variables 에 넣는다.

# 원시 DB 접속 주소. Supabase 연결 풀러(transaction 모드, 포트 6543)
# 예: postgresql://ade_collector.<프로젝트 ref>:<비밀번호>@aws-0-<리전>.pooler.supabase.com:6543/postgres
ADE_DB_URL=

# CORS 를 허용할 출처 (쉼표 구분). 비우면 localhost 만 허용
ADE_ORIGINS=

# 본문 상한 바이트 (기본 2MiB)
# ADE_BODY_LIMIT=2097152

# X-Forwarded-For 를 믿을 프록시 단계 수 (Vercel 은 1)
# ADE_TRUST_PROXY_HOPS=1
